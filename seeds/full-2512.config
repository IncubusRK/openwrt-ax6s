#
# Seed for OpenWrt 25.12 (apk) — Xiaomi Redmi AX6S / AX3200 (MT7622B).
#
# The file is deliberately minimal: it lists only what we choose on top of the
# target defaults. Everything else (kmod dependencies, build variants, target
# defaults) is generated by `make defconfig` in CI. Edit THIS file, never the
# .config inside the build tree.
#
# Removed on purpose (see README): python3/ruantiblock (replaced by zapret2),
# the old remittor zapret + ipset/iptables stack, OpenVPN/L2TP (AmneziaWG
# instead), AdGuard Home, docker, mihomo/OpenClash, v2raya/xray-core.
#

# --- Target ---------------------------------------------------------------
CONFIG_TARGET_mediatek=y
CONFIG_TARGET_mediatek_mt7622=y
CONFIG_TARGET_mediatek_mt7622_DEVICE_xiaomi_redmi-router-ax6s=y
CONFIG_TARGET_OPTIMIZATION="-Os -pipe -mcpu=cortex-a53"
CONFIG_TARGET_ROOTFS_SQUASHFS=y
CONFIG_TARGET_SQUASHFS_BLOCK_SIZE=256
CONFIG_TARGET_ROOTFS_PARTSIZE=104

# --- LuCI -----------------------------------------------------------------
CONFIG_PACKAGE_luci=y
CONFIG_PACKAGE_luci-theme-argon=y
CONFIG_PACKAGE_luci-i18n-argon-config-ru=y
CONFIG_PACKAGE_luci-i18n-base-ru=y
CONFIG_PACKAGE_luci-i18n-firewall-ru=y
CONFIG_PACKAGE_luci-app-attendedsysupgrade=y
CONFIG_PACKAGE_luci-app-sqm=y
CONFIG_PACKAGE_luci-app-nlbwmon=y
CONFIG_PACKAGE_luci-app-watchcat=y
CONFIG_PACKAGE_luci-app-zapret2=y
CONFIG_PACKAGE_luci-app-podkop=y

# --- DPI bypass: zapret2 (nftables, no ipset/python) ----------------------
CONFIG_PACKAGE_zapret2=y

# --- Domain routing: podkop + patched sing-box (XHTTP transport) ----------
# podkop-engine is podkop's own sing-box build: PROVIDES sing-box, ships
# XHTTP/VLESS-Encryption and Xray-compatible REALITY. Stock sing-box cannot
# do XHTTP, so it must stay out of the image.
CONFIG_PACKAGE_podkop=y
CONFIG_PACKAGE_podkop-engine=y
# CONFIG_PACKAGE_podkop-engine-full is not set
# CONFIG_PACKAGE_sing-box is not set
# CONFIG_PACKAGE_sing-box-tiny is not set

# --- VPN ------------------------------------------------------------------
CONFIG_PACKAGE_kmod-amneziawg=y
CONFIG_PACKAGE_amneziawg-tools=y
CONFIG_PACKAGE_luci-proto-amneziawg=y
CONFIG_PACKAGE_kmod-wireguard=y
CONFIG_PACKAGE_wireguard-tools=y
CONFIG_PACKAGE_luci-proto-wireguard=y

# --- DNS / networking -----------------------------------------------------
# podkop and zapret2 write dnsmasq nftsets: dnsmasq-full is required.
# CONFIG_PACKAGE_dnsmasq is not set
CONFIG_PACKAGE_dnsmasq-full=y
CONFIG_PACKAGE_kmod-tcp-bbr=y
# CONFIG_PACKAGE_wpad-basic-mbedtls is not set
CONFIG_PACKAGE_wpad-mbedtls=y

# --- QoS / accounting -----------------------------------------------------
CONFIG_PACKAGE_sqm-scripts=y
CONFIG_PACKAGE_kmod-sched-cake=y
CONFIG_PACKAGE_nlbwmon=y
CONFIG_PACKAGE_watchcat=y

# --- Diagnostics ----------------------------------------------------------
CONFIG_PACKAGE_iperf3=y
CONFIG_PACKAGE_tcpdump=y
CONFIG_PACKAGE_mtr-json=y

# --- Deliberately absent --------------------------------------------------
# CONFIG_PACKAGE_python3 is not set
# CONFIG_PACKAGE_ruantiblock is not set
# CONFIG_PACKAGE_zapret is not set
# CONFIG_PACKAGE_ipset is not set
# CONFIG_PACKAGE_luci-app-argon-config is not set
# CONFIG_PACKAGE_luci-ssl-openssl is not set
# CONFIG_PACKAGE_adguardhome is not set
# CONFIG_PACKAGE_luci-app-openclash is not set
# CONFIG_PACKAGE_v2raya is not set
# CONFIG_PACKAGE_xray-core is not set