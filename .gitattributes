# Normalize line endings: LF in the repository; shell scripts, seeds and
# uci-defaults are read/executed on Linux (CI) and on the router.
* text=auto
*.sh text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.json text eol=lf
*.config text eol=lf
files/etc/uci-defaults/* text eol=lf
files/etc/sysctl.d/* text eol=lf
files/usr/bin/* text eol=lf
files/usr/share/rpcd/ucode/* text eol=lf

# Firmware artifacts must never end up in the tree
*.itb binary
*.bin binary
*.img binary
*.gz binary
*.apk binary
*.ipk binary